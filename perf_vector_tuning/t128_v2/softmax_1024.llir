  %v157 = fmul float %v94, %v152
  %v158 = fmul float %v97, %v152
  call void asm sideeffect "st.global.v2.b32 [$2], {$0,$1};", "f,f,l"(float %v157, float %v158, ptr addrspace(1) %v156)
  %v159 = getelementptr float, ptr addrspace(1) %v13, i64 %v32
  %v160 = fmul float %v100, %v152
  %v161 = fmul float %v103, %v152
  call void asm sideeffect "st.global.v2.b32 [$2], {$0,$1};", "f,f,l"(float %v160, float %v161, ptr addrspace(1) %v159)
