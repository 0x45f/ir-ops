  %v83 = call float @llvm.maxnum.f32(float %v73, float %v76)
  %v84 = call float @llvm.maxnum.f32(float %v79, float %v82)
  %v85 = call float @llvm.maxnum.f32(float %v83, float %v84)
  call void @llvm.nvvm.barrier0()
  %v86 = fsub float %v23, %v85
  %v87 = fmul float %v86, 0x3FF7154760000000
  %v88 = call float @llvm.nvvm.ex2.approx.f32(float %v87)
  %v89 = fsub float %v24, %v85
  %v90 = fmul float %v89, 0x3FF7154760000000
  %v91 = call float @llvm.nvvm.ex2.approx.f32(float %v90)
  %v92 = fsub float %v29, %v85
  %v93 = fmul float %v92, 0x3FF7154760000000
  %v94 = call float @llvm.nvvm.ex2.approx.f32(float %v93)
  %v95 = fsub float %v30, %v85
  %v96 = fmul float %v95, 0x3FF7154760000000
  %v97 = call float @llvm.nvvm.ex2.approx.f32(float %v96)
  %v98 = fsub float %v35, %v85
  %v99 = fmul float %v98, 0x3FF7154760000000
  %v100 = call float @llvm.nvvm.ex2.approx.f32(float %v99)
  %v101 = fsub float %v36, %v85
  %v102 = fmul float %v101, 0x3FF7154760000000
  %v103 = call float @llvm.nvvm.ex2.approx.f32(float %v102)
  %v104 = fsub float %v42, %v85
  %v105 = fmul float %v104, 0x3FF7154760000000
  %v106 = call float @llvm.nvvm.ex2.approx.f32(float %v105)
  %v107 = fsub float %v43, %v85
  %v108 = fmul float %v107, 0x3FF7154760000000
  %v109 = call float @llvm.nvvm.ex2.approx.f32(float %v108)
  %v110 = fadd float %v88, %v91
  %v111 = fadd float %v94, %v97
  %v112 = fadd float %v100, %v103
  %v113 = fadd float %v106, %v109
  %v114 = fadd float %v110, %v111
  %v115 = fadd float %v112, %v113
  %v116 = fadd float %v114, %v115
  %v117 = bitcast float %v116 to i32
  %v118 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v117, i32 16, i32 31)
  %v119 = bitcast i32 %v118 to float
  %v120 = fadd float %v116, %v119
  %v121 = bitcast float %v120 to i32
  %v122 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v121, i32 8, i32 31)
  %v123 = bitcast i32 %v122 to float
  %v124 = fadd float %v120, %v123
  %v125 = bitcast float %v124 to i32
  %v126 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v125, i32 4, i32 31)
  %v127 = bitcast i32 %v126 to float
  %v128 = fadd float %v124, %v127
  %v129 = bitcast float %v128 to i32
  %v130 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v129, i32 2, i32 31)
  %v131 = bitcast i32 %v130 to float
  %v132 = fadd float %v128, %v131
  %v133 = bitcast float %v132 to i32
  %v134 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v133, i32 1, i32 31)
  %v135 = bitcast i32 %v134 to float
  %v136 = fadd float %v132, %v135
  call void asm sideeffect "@$2 st.shared.b32 [$0], $1;", "r,f,b"(ptr addrspace(3) %v17, float %v136, i1 %v18)
  call void @llvm.nvvm.barrier0()
  %v137 = add i32 %v16, 0
  %v138 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v137
  %v139 = load volatile float, ptr addrspace(3) %v138, align 4
  %v140 = add i32 %v16, 1
  %v141 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v140
  %v142 = load volatile float, ptr addrspace(3) %v141, align 4
  %v143 = add i32 %v16, 2
  %v144 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v143
  %v145 = load volatile float, ptr addrspace(3) %v144, align 4
  %v146 = add i32 %v16, 3
  %v147 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v146
  %v148 = load volatile float, ptr addrspace(3) %v147, align 4
  %v149 = fadd float %v139, %v142
  %v150 = fadd float %v145, %v148
  %v151 = fadd float %v149, %v150
  call void @llvm.nvvm.barrier0()
  %v152 = call float asm "rcp.approx.ftz.f32 $0, $1;", "=f,f"(float %v151)
