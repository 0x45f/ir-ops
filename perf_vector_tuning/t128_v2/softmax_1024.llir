  %v50 = call float @llvm.maxnum.f32(float %v48, float %v49)
  %v51 = bitcast float %v50 to i32
  %v52 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v51, i32 16, i32 31)
  %v53 = bitcast i32 %v52 to float
  %v54 = call float @llvm.maxnum.f32(float %v50, float %v53)
  %v55 = bitcast float %v54 to i32
  %v56 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v55, i32 8, i32 31)
  %v57 = bitcast i32 %v56 to float
  %v58 = call float @llvm.maxnum.f32(float %v54, float %v57)
  %v59 = bitcast float %v58 to i32
  %v60 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v59, i32 4, i32 31)
  %v61 = bitcast i32 %v60 to float
  %v62 = call float @llvm.maxnum.f32(float %v58, float %v61)
  %v63 = bitcast float %v62 to i32
  %v64 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v63, i32 2, i32 31)
  %v65 = bitcast i32 %v64 to float
  %v66 = call float @llvm.maxnum.f32(float %v62, float %v65)
  %v67 = bitcast float %v66 to i32
  %v68 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v67, i32 1, i32 31)
  %v69 = bitcast i32 %v68 to float
  %v70 = call float @llvm.maxnum.f32(float %v66, float %v69)
