  %v154 = fmul float %v88, %v152
  %v155 = fmul float %v91, %v152
  call void asm sideeffect "st.global.v2.b32 [$2], {$0,$1};", "f,f,l"(float %v154, float %v155, ptr addrspace(1) %v153)
