  %v22 = call {float, float} asm sideeffect "ld.global.v2.b32 {$0,$1}, [$2];", "=f,=f,l"(ptr addrspace(1) %v21)
  %v23 = extractvalue {float, float} %v22, 0
  %v24 = extractvalue {float, float} %v22, 1
  %v25 = add i32 %v15, 256
  %v26 = zext i32 %v25 to i64
  %v27 = getelementptr float, ptr addrspace(1) %v11, i64 %v26
  %v28 = call {float, float} asm sideeffect "ld.global.v2.b32 {$0,$1}, [$2];", "=f,=f,l"(ptr addrspace(1) %v27)
  %v29 = extractvalue {float, float} %v28, 0
  %v30 = extractvalue {float, float} %v28, 1
  %v31 = add i32 %v15, 512
  %v32 = zext i32 %v31 to i64
  %v33 = getelementptr float, ptr addrspace(1) %v11, i64 %v32
  %v34 = call {float, float} asm sideeffect "ld.global.v2.b32 {$0,$1}, [$2];", "=f,=f,l"(ptr addrspace(1) %v33)
  %v35 = extractvalue {float, float} %v34, 0
  %v36 = extractvalue {float, float} %v34, 1
  %v37 = add i32 %v15, 768
  %v38 = icmp ult i32 %v37, %cols
  %v39 = zext i32 %v37 to i64
  %v40 = getelementptr float, ptr addrspace(1) %v11, i64 %v39
  %v41 = call {float, float} asm sideeffect "mov.b32 $0, 0xff800000; mov.b32 $1, 0xff800000; @$3 ld.global.v2.b32 {$0,$1}, [$2];", "=f,=f,l,b"(ptr addrspace(1) %v40, i1 %v38)
  %v42 = extractvalue {float, float} %v41, 0
  %v43 = extractvalue {float, float} %v41, 1
  %v44 = call float @llvm.maxnum.f32(float %v23, float %v24)
  %v45 = call float @llvm.maxnum.f32(float %v29, float %v30)
  %v46 = call float @llvm.maxnum.f32(float %v35, float %v36)
  %v47 = call float @llvm.maxnum.f32(float %v42, float %v43)
  %v48 = call float @llvm.maxnum.f32(float %v44, float %v45)
