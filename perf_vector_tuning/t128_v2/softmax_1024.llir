  %v163 = fmul float %v106, %v152
  %v164 = fmul float %v109, %v152
  call void asm sideeffect "@$3 st.global.v2.b32 [$2], {$0,$1};", "f,f,l,b"(float %v163, float %v164, ptr addrspace(1) %v162, i1 %v38)
