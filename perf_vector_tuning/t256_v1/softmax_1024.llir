  %v101 = call float @llvm.nvvm.ex2.approx.f32(float %v100)
  %v102 = fadd float %v92, %v95
  %v103 = fadd float %v98, %v101
  %v104 = fadd float %v102, %v103
  %v105 = bitcast float %v104 to i32
  %v106 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v105, i32 16, i32 31)
  %v107 = bitcast i32 %v106 to float
  %v108 = fadd float %v104, %v107
  %v109 = bitcast float %v108 to i32
  %v110 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v109, i32 8, i32 31)
  %v111 = bitcast i32 %v110 to float
  %v112 = fadd float %v108, %v111
  %v113 = bitcast float %v112 to i32
  %v114 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v113, i32 4, i32 31)
  %v115 = bitcast i32 %v114 to float
  %v116 = fadd float %v112, %v115
  %v117 = bitcast float %v116 to i32
  %v118 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v117, i32 2, i32 31)
  %v119 = bitcast i32 %v118 to float
  %v120 = fadd float %v116, %v119
  %v121 = bitcast float %v120 to i32
  %v122 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v121, i32 1, i32 31)
  %v123 = bitcast i32 %v122 to float
  %v124 = fadd float %v120, %v123
  call void asm sideeffect "@$2 st.shared.b32 [$0], $1;", "r,f,b"(ptr addrspace(3) %v17, float %v124, i1 %v18)
