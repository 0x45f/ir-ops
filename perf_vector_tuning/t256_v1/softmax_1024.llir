  %v26 = call float asm sideeffect "ld.global.b32 $0, [$1];", "=f,l"(ptr addrspace(1) %v25)
  %v27 = add i32 %v15, 512
  %v28 = zext i32 %v27 to i64
  %v29 = getelementptr float, ptr addrspace(1) %v11, i64 %v28
  %v30 = call float asm sideeffect "ld.global.b32 $0, [$1];", "=f,l"(ptr addrspace(1) %v29)
  %v31 = add i32 %v15, 768
  %v32 = icmp ult i32 %v31, %cols
