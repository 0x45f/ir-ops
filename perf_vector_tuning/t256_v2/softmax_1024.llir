; Direct LLVM IR rewrite: vector loads -> register reductions -> vector stores.
; block=1024, num_warps=8, rows_per_cta=1, shared=32
target datalayout = "e-p3:32:32-p4:32:32-p5:32:32-p6:32:32-p7:32:32-i64:64-i128:128-v16:16-v32:32-n16:32:64"
@global_smem = external addrspace(3) global [0 x i8], align 16
define ptx_kernel void @softmax_kernel(ptr addrspace(1) %out, ptr addrspace(1) %in, i32 %istride, i32 %ostride, i32 %rows, i32 %cols, ptr addrspace(1) %scratch, ptr addrspace(1) %profile) #0 {
entry:
  %v1 = call i32 @llvm.nvvm.read.ptx.sreg.tid.x()
  %v2 = call i32 @llvm.nvvm.read.ptx.sreg.ctaid.x()
  %v3 = and i32 %v1, 31
  %v4 = lshr i32 %v1, 5
  %v5 = udiv i32 %v1, 256
  %v6 = icmp ult i32 %v2, %rows
  br i1 %v6, label %body, label %exit
body:
  %v7 = zext i32 %v2 to i64
  %v8 = zext i32 %istride to i64
  %v9 = zext i32 %ostride to i64
  %v10 = mul i64 %v7, %v8
  %v11 = getelementptr float, ptr addrspace(1) %in, i64 %v10
  %v12 = mul i64 %v7, %v9
  %v13 = getelementptr float, ptr addrspace(1) %out, i64 %v12
  %v14 = urem i32 %v1, 256
  %v15 = mul i32 %v14, 2
  %v16 = mul i32 %v5, 8
  %v17 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v4
  %v18 = icmp eq i32 %v3, 0
  %v19 = add i32 %v15, 0
  %v20 = zext i32 %v19 to i64
  %v21 = getelementptr float, ptr addrspace(1) %v11, i64 %v20
  %v22 = call {float, float} asm sideeffect "ld.global.v2.b32 {$0,$1}, [$2];", "=f,=f,l"(ptr addrspace(1) %v21)
  %v23 = extractvalue {float, float} %v22, 0
  %v24 = extractvalue {float, float} %v22, 1
  %v25 = add i32 %v15, 512
  %v26 = icmp ult i32 %v25, %cols
  %v27 = zext i32 %v25 to i64
  %v28 = getelementptr float, ptr addrspace(1) %v11, i64 %v27
  %v29 = call {float, float} asm sideeffect "mov.b32 $0, 0xff800000; mov.b32 $1, 0xff800000; @$3 ld.global.v2.b32 {$0,$1}, [$2];", "=f,=f,l,b"(ptr addrspace(1) %v28, i1 %v26)
  %v30 = extractvalue {float, float} %v29, 0
  %v31 = extractvalue {float, float} %v29, 1
  %v32 = call float @llvm.maxnum.f32(float %v23, float %v24)
  %v33 = call float @llvm.maxnum.f32(float %v30, float %v31)
  %v34 = call float @llvm.maxnum.f32(float %v32, float %v33)
  %v35 = bitcast float %v34 to i32
  %v36 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v35, i32 16, i32 31)
  %v37 = bitcast i32 %v36 to float
  %v38 = call float @llvm.maxnum.f32(float %v34, float %v37)
  %v39 = bitcast float %v38 to i32
  %v40 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v39, i32 8, i32 31)
  %v41 = bitcast i32 %v40 to float
  %v42 = call float @llvm.maxnum.f32(float %v38, float %v41)
  %v43 = bitcast float %v42 to i32
  %v44 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v43, i32 4, i32 31)
  %v45 = bitcast i32 %v44 to float
  %v46 = call float @llvm.maxnum.f32(float %v42, float %v45)
  %v47 = bitcast float %v46 to i32
  %v48 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v47, i32 2, i32 31)
  %v49 = bitcast i32 %v48 to float
  %v50 = call float @llvm.maxnum.f32(float %v46, float %v49)
  %v51 = bitcast float %v50 to i32
  %v52 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v51, i32 1, i32 31)
  %v53 = bitcast i32 %v52 to float
  %v54 = call float @llvm.maxnum.f32(float %v50, float %v53)
  call void asm sideeffect "@$2 st.shared.b32 [$0], $1;", "r,f,b"(ptr addrspace(3) %v17, float %v54, i1 %v18)
  call void @llvm.nvvm.barrier0()
  %v55 = add i32 %v16, 0
  %v56 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v55
  %v57 = load volatile float, ptr addrspace(3) %v56, align 4
  %v58 = add i32 %v16, 1
  %v59 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v58
  %v60 = load volatile float, ptr addrspace(3) %v59, align 4
  %v61 = add i32 %v16, 2
  %v62 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v61
  %v63 = load volatile float, ptr addrspace(3) %v62, align 4
  %v64 = add i32 %v16, 3
  %v65 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v64
  %v66 = load volatile float, ptr addrspace(3) %v65, align 4
  %v67 = add i32 %v16, 4
  %v68 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v67
  %v69 = load volatile float, ptr addrspace(3) %v68, align 4
  %v70 = add i32 %v16, 5
  %v71 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v70
  %v72 = load volatile float, ptr addrspace(3) %v71, align 4
  %v73 = add i32 %v16, 6
  %v74 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v73
  %v75 = load volatile float, ptr addrspace(3) %v74, align 4
  %v76 = add i32 %v16, 7
  %v77 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v76
  %v78 = load volatile float, ptr addrspace(3) %v77, align 4
  %v79 = call float @llvm.maxnum.f32(float %v57, float %v60)
  %v80 = call float @llvm.maxnum.f32(float %v63, float %v66)
  %v81 = call float @llvm.maxnum.f32(float %v69, float %v72)
  %v82 = call float @llvm.maxnum.f32(float %v75, float %v78)
  %v83 = call float @llvm.maxnum.f32(float %v79, float %v80)
  %v84 = call float @llvm.maxnum.f32(float %v81, float %v82)
  %v85 = call float @llvm.maxnum.f32(float %v83, float %v84)
  call void @llvm.nvvm.barrier0()
  %v86 = fsub float %v23, %v85
  %v87 = fmul float %v86, 0x3FF7154760000000
  %v88 = call float @llvm.nvvm.ex2.approx.f32(float %v87)
  %v89 = fsub float %v24, %v85
  %v90 = fmul float %v89, 0x3FF7154760000000
  %v91 = call float @llvm.nvvm.ex2.approx.f32(float %v90)
  %v92 = fsub float %v30, %v85
  %v93 = fmul float %v92, 0x3FF7154760000000
  %v94 = call float @llvm.nvvm.ex2.approx.f32(float %v93)
  %v95 = fsub float %v31, %v85
  %v96 = fmul float %v95, 0x3FF7154760000000
  %v97 = call float @llvm.nvvm.ex2.approx.f32(float %v96)
  %v98 = fadd float %v88, %v91
  %v99 = fadd float %v94, %v97
  %v100 = fadd float %v98, %v99
  %v101 = bitcast float %v100 to i32
  %v102 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v101, i32 16, i32 31)
  %v103 = bitcast i32 %v102 to float
  %v104 = fadd float %v100, %v103
  %v105 = bitcast float %v104 to i32
  %v106 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v105, i32 8, i32 31)
  %v107 = bitcast i32 %v106 to float
  %v108 = fadd float %v104, %v107
  %v109 = bitcast float %v108 to i32
  %v110 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v109, i32 4, i32 31)
  %v111 = bitcast i32 %v110 to float
  %v112 = fadd float %v108, %v111
  %v113 = bitcast float %v112 to i32
  %v114 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v113, i32 2, i32 31)
  %v115 = bitcast i32 %v114 to float
  %v116 = fadd float %v112, %v115
  %v117 = bitcast float %v116 to i32
  %v118 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v117, i32 1, i32 31)
  %v119 = bitcast i32 %v118 to float
  %v120 = fadd float %v116, %v119
  call void asm sideeffect "@$2 st.shared.b32 [$0], $1;", "r,f,b"(ptr addrspace(3) %v17, float %v120, i1 %v18)
  call void @llvm.nvvm.barrier0()
  %v121 = add i32 %v16, 0
  %v122 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v121
  %v123 = load volatile float, ptr addrspace(3) %v122, align 4
  %v124 = add i32 %v16, 1
  %v125 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v124
  %v126 = load volatile float, ptr addrspace(3) %v125, align 4
  %v127 = add i32 %v16, 2
  %v128 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v127
  %v129 = load volatile float, ptr addrspace(3) %v128, align 4
  %v130 = add i32 %v16, 3
  %v131 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v130
  %v132 = load volatile float, ptr addrspace(3) %v131, align 4
  %v133 = add i32 %v16, 4
  %v134 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v133
  %v135 = load volatile float, ptr addrspace(3) %v134, align 4
  %v136 = add i32 %v16, 5
  %v137 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v136
  %v138 = load volatile float, ptr addrspace(3) %v137, align 4
  %v139 = add i32 %v16, 6
  %v140 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v139
  %v141 = load volatile float, ptr addrspace(3) %v140, align 4
  %v142 = add i32 %v16, 7
  %v143 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v142
  %v144 = load volatile float, ptr addrspace(3) %v143, align 4
  %v145 = fadd float %v123, %v126
  %v146 = fadd float %v129, %v132
  %v147 = fadd float %v135, %v138
  %v148 = fadd float %v141, %v144
  %v149 = fadd float %v145, %v146
  %v150 = fadd float %v147, %v148
  %v151 = fadd float %v149, %v150
  call void @llvm.nvvm.barrier0()
  %v152 = call float asm "rcp.approx.ftz.f32 $0, $1;", "=f,f"(float %v151)
  %v153 = getelementptr float, ptr addrspace(1) %v13, i64 %v20
  %v154 = fmul float %v88, %v152
  %v155 = fmul float %v91, %v152
  call void asm sideeffect "st.global.v2.b32 [$2], {$0,$1};", "f,f,l"(float %v154, float %v155, ptr addrspace(1) %v153)
  %v156 = getelementptr float, ptr addrspace(1) %v13, i64 %v27
  %v157 = fmul float %v94, %v152
  %v158 = fmul float %v97, %v152
  call void asm sideeffect "@$3 st.global.v2.b32 [$2], {$0,$1};", "f,f,l,b"(float %v157, float %v158, ptr addrspace(1) %v156, i1 %v26)
  br label %exit
exit:
  ret void
}
declare i32 @llvm.nvvm.read.ptx.sreg.tid.x()
declare i32 @llvm.nvvm.read.ptx.sreg.ctaid.x()
declare float @llvm.maxnum.f32(float, float)
declare i32 @llvm.nvvm.shfl.sync.bfly.i32(i32, i32, i32, i32)
declare float @llvm.nvvm.ex2.approx.f32(float)
declare void @llvm.nvvm.barrier0()
attributes #0 = { nounwind "nvvm.reqntid"="256" }
