  %v147 = load volatile float, ptr addrspace(3) %v146, align 4
  %v148 = add i32 %v16, 1
  %v149 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v148
  %v150 = load volatile float, ptr addrspace(3) %v149, align 4
  %v151 = add i32 %v16, 2
  %v152 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v151
  %v153 = load volatile float, ptr addrspace(3) %v152, align 4
  %v154 = add i32 %v16, 3
  %v155 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v154
  %v156 = load volatile float, ptr addrspace(3) %v155, align 4
  %v157 = add i32 %v16, 4
  %v158 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v157
  %v159 = load volatile float, ptr addrspace(3) %v158, align 4
  %v160 = add i32 %v16, 5
  %v161 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v160
  %v162 = load volatile float, ptr addrspace(3) %v161, align 4
  %v163 = add i32 %v16, 6
