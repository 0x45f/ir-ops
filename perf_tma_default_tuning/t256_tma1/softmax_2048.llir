  %v165 = load volatile float, ptr addrspace(3) %v164, align 4
  %v166 = add i32 %v16, 7
  %v167 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v166
  %v168 = load volatile float, ptr addrspace(3) %v167, align 4
  %v169 = fadd float %v147, %v150
  %v170 = fadd float %v153, %v156
