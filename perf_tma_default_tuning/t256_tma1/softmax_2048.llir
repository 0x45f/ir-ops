  %v96 = call float @llvm.nvvm.ex2.approx.f32(float %v95)
  %v97 = fsub float %v24, %v93
  %v98 = fmul float %v97, 0x3FF7154760000000
  %v99 = call float @llvm.nvvm.ex2.approx.f32(float %v98)
  %v100 = fsub float %v25, %v93
  %v101 = fmul float %v100, 0x3FF7154760000000
  %v102 = call float @llvm.nvvm.ex2.approx.f32(float %v101)
  %v103 = fsub float %v26, %v93
  %v104 = fmul float %v103, 0x3FF7154760000000
  %v105 = call float @llvm.nvvm.ex2.approx.f32(float %v104)
  %v106 = fsub float %v32, %v93
  %v107 = fmul float %v106, 0x3FF7154760000000
  %v108 = call float @llvm.nvvm.ex2.approx.f32(float %v107)
  %v109 = fsub float %v33, %v93
  %v110 = fmul float %v109, 0x3FF7154760000000
  %v111 = call float @llvm.nvvm.ex2.approx.f32(float %v110)
  %v112 = fsub float %v34, %v93
  %v113 = fmul float %v112, 0x3FF7154760000000
  %v114 = call float @llvm.nvvm.ex2.approx.f32(float %v113)
  %v115 = fsub float %v35, %v93
  %v116 = fmul float %v115, 0x3FF7154760000000
  %v117 = call float @llvm.nvvm.ex2.approx.f32(float %v116)
  %v118 = fadd float %v96, %v99
  %v119 = fadd float %v102, %v105
  %v120 = fadd float %v108, %v111
  %v121 = fadd float %v114, %v117
  %v122 = fadd float %v118, %v119
  %v123 = fadd float %v120, %v121
  %v124 = fadd float %v122, %v123
  %v125 = bitcast float %v124 to i32
  %v126 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v125, i32 16, i32 31)
  %v127 = bitcast i32 %v126 to float
  %v128 = fadd float %v124, %v127
  %v129 = bitcast float %v128 to i32
  %v130 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v129, i32 8, i32 31)
  %v131 = bitcast i32 %v130 to float
  %v132 = fadd float %v128, %v131
  %v133 = bitcast float %v132 to i32
  %v134 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v133, i32 4, i32 31)
  %v135 = bitcast i32 %v134 to float
