  %v137 = bitcast float %v136 to i32
  %v138 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v137, i32 2, i32 31)
  %v139 = bitcast i32 %v138 to float
  %v140 = fadd float %v136, %v139
  %v141 = bitcast float %v140 to i32
  %v142 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v141, i32 1, i32 31)
