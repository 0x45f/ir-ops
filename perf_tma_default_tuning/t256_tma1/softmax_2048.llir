  %v28 = icmp ult i32 %v27, %cols
  %v29 = zext i32 %v27 to i64
  %v30 = getelementptr float, ptr addrspace(1) %v11, i64 %v29
  %v31 = call {float, float, float, float} asm sideeffect "mov.b32 $0, 0xff800000; mov.b32 $1, 0xff800000; mov.b32 $2, 0xff800000; mov.b32 $3, 0xff800000; @$5 ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l,b"(ptr addrspace(1) %v30, i1 %v28)
  %v32 = extractvalue {float, float, float, float} %v31, 0
  %v33 = extractvalue {float, float, float, float} %v31, 1
  %v34 = extractvalue {float, float, float, float} %v31, 2
  %v35 = extractvalue {float, float, float, float} %v31, 3
  %v36 = call float @llvm.maxnum.f32(float %v23, float %v24)
  %v37 = call float @llvm.maxnum.f32(float %v25, float %v26)
  %v38 = call float @llvm.maxnum.f32(float %v32, float %v33)
  %v39 = call float @llvm.maxnum.f32(float %v34, float %v35)
  %v40 = call float @llvm.maxnum.f32(float %v36, float %v37)
  %v41 = call float @llvm.maxnum.f32(float %v38, float %v39)
  %v42 = call float @llvm.maxnum.f32(float %v40, float %v41)
  %v43 = bitcast float %v42 to i32
  %v44 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v43, i32 16, i32 31)
  %v45 = bitcast i32 %v44 to float
  %v46 = call float @llvm.maxnum.f32(float %v42, float %v45)
  %v47 = bitcast float %v46 to i32
  %v48 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v47, i32 8, i32 31)
  %v49 = bitcast i32 %v48 to float
