  %v180 = fmul float %v99, %v176
  %v181 = fmul float %v102, %v176
  %v182 = fmul float %v105, %v176
  call void asm sideeffect "@$5 st.shared.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,r,b"(float %v179, float %v180, float %v181, float %v182, ptr addrspace(3) %v178, i1 true)
