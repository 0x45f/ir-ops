  call void asm sideeffect "@$5 st.shared.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,r,b"(float %v185, float %v186, float %v187, float %v188, ptr addrspace(3) %v184, i1 %v28)
