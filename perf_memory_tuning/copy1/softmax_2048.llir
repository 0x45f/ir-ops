; Direct LLVM IR rewrite: vector loads -> register reductions -> vector stores.
; block=2048, num_warps=4, rows_per_cta=1, shared=16
target datalayout = "e-p3:32:32-p4:32:32-p5:32:32-p6:32:32-p7:32:32-i64:64-i128:128-v16:16-v32:32-n16:32:64"
@global_smem = external addrspace(3) global [0 x i8], align 16
define ptx_kernel void @softmax_kernel(ptr addrspace(1) %out, ptr addrspace(1) %in, i32 %istride, i32 %ostride, i32 %rows, i32 %cols, ptr addrspace(1) %scratch, ptr addrspace(1) %profile) #0 {
entry:
  %v1 = call i32 @llvm.nvvm.read.ptx.sreg.tid.x()
  %v2 = call i32 @llvm.nvvm.read.ptx.sreg.ctaid.x()
  %v3 = and i32 %v1, 31
  %v4 = lshr i32 %v1, 5
  %v5 = udiv i32 %v1, 128
  %v6 = icmp ult i32 %v2, %rows
  br i1 %v6, label %body, label %exit
body:
  %v7 = zext i32 %v2 to i64
  %v8 = zext i32 %istride to i64
  %v9 = zext i32 %ostride to i64
  %v10 = mul i64 %v7, %v8
  %v11 = getelementptr float, ptr addrspace(1) %in, i64 %v10
  %v12 = mul i64 %v7, %v9
  %v13 = getelementptr float, ptr addrspace(1) %out, i64 %v12
  %v14 = urem i32 %v1, 128
  %v15 = mul i32 %v14, 4
  %v16 = mul i32 %v5, 4
  %v17 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v4
  %v18 = icmp eq i32 %v3, 0
  %v19 = add i32 %v15, 0
  %v20 = zext i32 %v19 to i64
  %v21 = getelementptr float, ptr addrspace(1) %v11, i64 %v20
  %v22 = call {float, float, float, float} asm sideeffect "ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l"(ptr addrspace(1) %v21)
  %v23 = extractvalue {float, float, float, float} %v22, 0
  %v24 = extractvalue {float, float, float, float} %v22, 1
  %v25 = extractvalue {float, float, float, float} %v22, 2
  %v26 = extractvalue {float, float, float, float} %v22, 3
  %v27 = add i32 %v15, 512
  %v28 = zext i32 %v27 to i64
  %v29 = getelementptr float, ptr addrspace(1) %v11, i64 %v28
  %v30 = call {float, float, float, float} asm sideeffect "ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l"(ptr addrspace(1) %v29)
  %v31 = extractvalue {float, float, float, float} %v30, 0
  %v32 = extractvalue {float, float, float, float} %v30, 1
  %v33 = extractvalue {float, float, float, float} %v30, 2
  %v34 = extractvalue {float, float, float, float} %v30, 3
  %v35 = add i32 %v15, 1024
  %v36 = zext i32 %v35 to i64
  %v37 = getelementptr float, ptr addrspace(1) %v11, i64 %v36
  %v38 = call {float, float, float, float} asm sideeffect "ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l"(ptr addrspace(1) %v37)
  %v39 = extractvalue {float, float, float, float} %v38, 0
  %v40 = extractvalue {float, float, float, float} %v38, 1
  %v41 = extractvalue {float, float, float, float} %v38, 2
  %v42 = extractvalue {float, float, float, float} %v38, 3
  %v43 = add i32 %v15, 1536
  %v44 = icmp ult i32 %v43, %cols
  %v45 = zext i32 %v43 to i64
  %v46 = getelementptr float, ptr addrspace(1) %v11, i64 %v45
  %v47 = call {float, float, float, float} asm sideeffect "mov.b32 $0, 0xff800000; mov.b32 $1, 0xff800000; mov.b32 $2, 0xff800000; mov.b32 $3, 0xff800000; @$5 ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l,b"(ptr addrspace(1) %v46, i1 %v44)
  %v48 = extractvalue {float, float, float, float} %v47, 0
  %v49 = extractvalue {float, float, float, float} %v47, 1
  %v50 = extractvalue {float, float, float, float} %v47, 2
  %v51 = extractvalue {float, float, float, float} %v47, 3
  %v52 = getelementptr float, ptr addrspace(1) %v13, i64 %v20
  %v53 = fmul float %v23, 1.000000e+00
  %v54 = fmul float %v24, 1.000000e+00
  %v55 = fmul float %v25, 1.000000e+00
  %v56 = fmul float %v26, 1.000000e+00
  call void asm sideeffect "st.global.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,l"(float %v53, float %v54, float %v55, float %v56, ptr addrspace(1) %v52)
  %v57 = getelementptr float, ptr addrspace(1) %v13, i64 %v28
  %v58 = fmul float %v31, 1.000000e+00
  %v59 = fmul float %v32, 1.000000e+00
  %v60 = fmul float %v33, 1.000000e+00
  %v61 = fmul float %v34, 1.000000e+00
  call void asm sideeffect "st.global.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,l"(float %v58, float %v59, float %v60, float %v61, ptr addrspace(1) %v57)
  %v62 = getelementptr float, ptr addrspace(1) %v13, i64 %v36
  %v63 = fmul float %v39, 1.000000e+00
  %v64 = fmul float %v40, 1.000000e+00
  %v65 = fmul float %v41, 1.000000e+00
  %v66 = fmul float %v42, 1.000000e+00
  call void asm sideeffect "st.global.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,l"(float %v63, float %v64, float %v65, float %v66, ptr addrspace(1) %v62)
  %v67 = getelementptr float, ptr addrspace(1) %v13, i64 %v45
  %v68 = fmul float %v48, 1.000000e+00
  %v69 = fmul float %v49, 1.000000e+00
  %v70 = fmul float %v50, 1.000000e+00
  %v71 = fmul float %v51, 1.000000e+00
  call void asm sideeffect "@$5 st.global.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,l,b"(float %v68, float %v69, float %v70, float %v71, ptr addrspace(1) %v67, i1 %v44)
  br label %exit
exit:
  ret void
}
declare i32 @llvm.nvvm.read.ptx.sreg.tid.x()
declare i32 @llvm.nvvm.read.ptx.sreg.ctaid.x()
declare float @llvm.maxnum.f32(float, float)
declare i32 @llvm.nvvm.shfl.sync.bfly.i32(i32, i32, i32, i32)
declare float @llvm.nvvm.ex2.approx.f32(float)
declare void @llvm.nvvm.barrier0()
attributes #0 = { nounwind "nvvm.reqntid"="128" }
