; Direct LLVM IR rewrite: vector loads -> register reductions -> vector stores.
; block=1024, num_warps=8, rows_per_cta=1, shared=32
target datalayout = "e-p3:32:32-p4:32:32-p5:32:32-p6:32:32-p7:32:32-i64:64-i128:128-v16:16-v32:32-n16:32:64"
@global_smem = external addrspace(3) global [0 x i8], align 16
define ptx_kernel void @softmax_kernel(ptr addrspace(1) %out, ptr addrspace(1) %in, i32 %istride, i32 %ostride, i32 %rows, i32 %cols, ptr addrspace(1) %scratch, ptr addrspace(1) %profile) #0 {
entry:
  %v1 = call i32 @llvm.nvvm.read.ptx.sreg.tid.x()
  %v2 = call i32 @llvm.nvvm.read.ptx.sreg.ctaid.x()
  %v3 = and i32 %v1, 31
  %v4 = lshr i32 %v1, 5
  %v5 = udiv i32 %v1, 256
  %v6 = icmp ult i32 %v2, %rows
  br i1 %v6, label %body, label %exit
body:
  %v7 = zext i32 %v2 to i64
  %v8 = zext i32 %istride to i64
  %v9 = zext i32 %ostride to i64
  %v10 = mul i64 %v7, %v8
  %v11 = getelementptr float, ptr addrspace(1) %in, i64 %v10
  %v12 = mul i64 %v7, %v9
  %v13 = getelementptr float, ptr addrspace(1) %out, i64 %v12
  %v14 = urem i32 %v1, 256
  %v15 = mul i32 %v14, 4
  %v16 = mul i32 %v5, 8
  %v17 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v4
  %v18 = icmp eq i32 %v3, 0
  %v19 = add i32 %v15, 0
  %v20 = icmp ult i32 %v19, %cols
  %v21 = zext i32 %v19 to i64
  %v22 = getelementptr float, ptr addrspace(1) %v11, i64 %v21
  %v23 = call {float, float, float, float} asm sideeffect "mov.b32 $0, 0xff800000; mov.b32 $1, 0xff800000; mov.b32 $2, 0xff800000; mov.b32 $3, 0xff800000; @$5 ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l,b"(ptr addrspace(1) %v22, i1 %v20)
  %v24 = extractvalue {float, float, float, float} %v23, 0
  %v25 = extractvalue {float, float, float, float} %v23, 1
  %v26 = extractvalue {float, float, float, float} %v23, 2
  %v27 = extractvalue {float, float, float, float} %v23, 3
  %v28 = call float @llvm.maxnum.f32(float %v24, float %v25)
  %v29 = call float @llvm.maxnum.f32(float %v26, float %v27)
  %v30 = call float @llvm.maxnum.f32(float %v28, float %v29)
  %v31 = bitcast float %v30 to i32
  %v32 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v31, i32 16, i32 31)
  %v33 = bitcast i32 %v32 to float
  %v34 = call float @llvm.maxnum.f32(float %v30, float %v33)
  %v35 = bitcast float %v34 to i32
  %v36 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v35, i32 8, i32 31)
  %v37 = bitcast i32 %v36 to float
  %v38 = call float @llvm.maxnum.f32(float %v34, float %v37)
  %v39 = bitcast float %v38 to i32
  %v40 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v39, i32 4, i32 31)
  %v41 = bitcast i32 %v40 to float
  %v42 = call float @llvm.maxnum.f32(float %v38, float %v41)
  %v43 = bitcast float %v42 to i32
  %v44 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v43, i32 2, i32 31)
  %v45 = bitcast i32 %v44 to float
  %v46 = call float @llvm.maxnum.f32(float %v42, float %v45)
  %v47 = bitcast float %v46 to i32
  %v48 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v47, i32 1, i32 31)
  %v49 = bitcast i32 %v48 to float
  %v50 = call float @llvm.maxnum.f32(float %v46, float %v49)
  call void asm sideeffect "@$2 st.shared.b32 [$0], $1;", "r,f,b"(ptr addrspace(3) %v17, float %v50, i1 %v18)
  call void @llvm.nvvm.barrier0()
  %v51 = add i32 %v16, 0
  %v52 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v51
  %v53 = load volatile float, ptr addrspace(3) %v52, align 4
  %v54 = add i32 %v16, 1
  %v55 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v54
  %v56 = load volatile float, ptr addrspace(3) %v55, align 4
  %v57 = add i32 %v16, 2
  %v58 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v57
  %v59 = load volatile float, ptr addrspace(3) %v58, align 4
  %v60 = add i32 %v16, 3
  %v61 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v60
  %v62 = load volatile float, ptr addrspace(3) %v61, align 4
  %v63 = add i32 %v16, 4
  %v64 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v63
  %v65 = load volatile float, ptr addrspace(3) %v64, align 4
  %v66 = add i32 %v16, 5
  %v67 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v66
  %v68 = load volatile float, ptr addrspace(3) %v67, align 4
  %v69 = add i32 %v16, 6
  %v70 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v69
  %v71 = load volatile float, ptr addrspace(3) %v70, align 4
  %v72 = add i32 %v16, 7
  %v73 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v72
  %v74 = load volatile float, ptr addrspace(3) %v73, align 4
  %v75 = call float @llvm.maxnum.f32(float %v53, float %v56)
  %v76 = call float @llvm.maxnum.f32(float %v59, float %v62)
  %v77 = call float @llvm.maxnum.f32(float %v65, float %v68)
  %v78 = call float @llvm.maxnum.f32(float %v71, float %v74)
  %v79 = call float @llvm.maxnum.f32(float %v75, float %v76)
  %v80 = call float @llvm.maxnum.f32(float %v77, float %v78)
  %v81 = call float @llvm.maxnum.f32(float %v79, float %v80)
  call void @llvm.nvvm.barrier0()
  %v82 = fsub float %v24, %v81
  %v83 = fmul float %v82, 0x3FF7154760000000
  %v84 = call float @llvm.nvvm.ex2.approx.f32(float %v83)
  %v85 = fsub float %v25, %v81
  %v86 = fmul float %v85, 0x3FF7154760000000
  %v87 = call float @llvm.nvvm.ex2.approx.f32(float %v86)
  %v88 = fsub float %v26, %v81
  %v89 = fmul float %v88, 0x3FF7154760000000
  %v90 = call float @llvm.nvvm.ex2.approx.f32(float %v89)
  %v91 = fsub float %v27, %v81
  %v92 = fmul float %v91, 0x3FF7154760000000
  %v93 = call float @llvm.nvvm.ex2.approx.f32(float %v92)
  %v94 = fadd float %v84, %v87
  %v95 = fadd float %v90, %v93
  %v96 = fadd float %v94, %v95
  %v97 = bitcast float %v96 to i32
  %v98 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v97, i32 16, i32 31)
  %v99 = bitcast i32 %v98 to float
  %v100 = fadd float %v96, %v99
  %v101 = bitcast float %v100 to i32
  %v102 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v101, i32 8, i32 31)
  %v103 = bitcast i32 %v102 to float
  %v104 = fadd float %v100, %v103
  %v105 = bitcast float %v104 to i32
  %v106 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v105, i32 4, i32 31)
  %v107 = bitcast i32 %v106 to float
  %v108 = fadd float %v104, %v107
  %v109 = bitcast float %v108 to i32
  %v110 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v109, i32 2, i32 31)
  %v111 = bitcast i32 %v110 to float
  %v112 = fadd float %v108, %v111
  %v113 = bitcast float %v112 to i32
  %v114 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v113, i32 1, i32 31)
  %v115 = bitcast i32 %v114 to float
  %v116 = fadd float %v112, %v115
  call void asm sideeffect "@$2 st.shared.b32 [$0], $1;", "r,f,b"(ptr addrspace(3) %v17, float %v116, i1 %v18)
  call void @llvm.nvvm.barrier0()
  %v117 = add i32 %v16, 0
  %v118 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v117
  %v119 = load volatile float, ptr addrspace(3) %v118, align 4
  %v120 = add i32 %v16, 1
  %v121 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v120
  %v122 = load volatile float, ptr addrspace(3) %v121, align 4
  %v123 = add i32 %v16, 2
  %v124 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v123
  %v125 = load volatile float, ptr addrspace(3) %v124, align 4
  %v126 = add i32 %v16, 3
  %v127 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v126
  %v128 = load volatile float, ptr addrspace(3) %v127, align 4
  %v129 = add i32 %v16, 4
  %v130 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v129
  %v131 = load volatile float, ptr addrspace(3) %v130, align 4
  %v132 = add i32 %v16, 5
  %v133 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v132
  %v134 = load volatile float, ptr addrspace(3) %v133, align 4
  %v135 = add i32 %v16, 6
  %v136 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v135
  %v137 = load volatile float, ptr addrspace(3) %v136, align 4
  %v138 = add i32 %v16, 7
  %v139 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v138
  %v140 = load volatile float, ptr addrspace(3) %v139, align 4
  %v141 = fadd float %v119, %v122
  %v142 = fadd float %v125, %v128
  %v143 = fadd float %v131, %v134
  %v144 = fadd float %v137, %v140
  %v145 = fadd float %v141, %v142
  %v146 = fadd float %v143, %v144
  %v147 = fadd float %v145, %v146
  call void @llvm.nvvm.barrier0()
  %v148 = call float asm "rcp.approx.ftz.f32 $0, $1;", "=f,f"(float %v147)
  %v149 = getelementptr float, ptr addrspace(1) %v13, i64 %v21
  %v150 = fmul float %v84, %v148
  %v151 = fmul float %v87, %v148
  %v152 = fmul float %v90, %v148
  %v153 = fmul float %v93, %v148
  call void asm sideeffect "@$5 st.global.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,l,b"(float %v150, float %v151, float %v152, float %v153, ptr addrspace(1) %v149, i1 %v20)
  br label %exit
exit:
  ret void
}
declare i32 @llvm.nvvm.read.ptx.sreg.tid.x()
declare i32 @llvm.nvvm.read.ptx.sreg.ctaid.x()
declare float @llvm.maxnum.f32(float, float)
declare i32 @llvm.nvvm.shfl.sync.bfly.i32(i32, i32, i32, i32)
declare float @llvm.nvvm.ex2.approx.f32(float)
declare void @llvm.nvvm.barrier0()
attributes #0 = { nounwind "nvvm.reqntid"="256" }
