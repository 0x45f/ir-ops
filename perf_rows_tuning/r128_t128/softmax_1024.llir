; Direct LLVM IR rewrite: vector loads -> register reductions -> vector stores.
; block=1024, num_warps=4, rows_per_cta=1, shared=16
target datalayout = "e-p3:32:32-p4:32:32-p5:32:32-p6:32:32-p7:32:32-i64:64-i128:128-v16:16-v32:32-n16:32:64"
@global_smem = external addrspace(3) global [0 x i8], align 16
define ptx_kernel void @softmax_kernel(ptr addrspace(1) %out, ptr addrspace(1) %in, i32 %istride, i32 %ostride, i32 %rows, i32 %cols, ptr addrspace(1) %scratch, ptr addrspace(1) %profile) #0 {
entry:
  %v1 = call i32 @llvm.nvvm.read.ptx.sreg.tid.x()
  %v2 = call i32 @llvm.nvvm.read.ptx.sreg.ctaid.x()
  %v3 = and i32 %v1, 31
  %v4 = lshr i32 %v1, 5
  %v5 = udiv i32 %v1, 128
  %v6 = icmp ult i32 %v2, %rows
  br i1 %v6, label %body, label %exit
body:
  %v7 = zext i32 %v2 to i64
  %v8 = zext i32 %istride to i64
  %v9 = zext i32 %ostride to i64
  %v10 = mul i64 %v7, %v8
  %v11 = getelementptr float, ptr addrspace(1) %in, i64 %v10
  %v12 = mul i64 %v7, %v9
  %v13 = getelementptr float, ptr addrspace(1) %out, i64 %v12
  %v14 = urem i32 %v1, 128
  %v15 = mul i32 %v14, 4
  %v16 = mul i32 %v5, 4
  %v17 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v4
  %v18 = icmp eq i32 %v3, 0
  %v19 = add i32 %v15, 0
  %v20 = icmp ult i32 %v19, %cols
  %v21 = zext i32 %v19 to i64
  %v22 = getelementptr float, ptr addrspace(1) %v11, i64 %v21
  %v23 = call {float, float, float, float} asm sideeffect "mov.b32 $0, 0xff800000; mov.b32 $1, 0xff800000; mov.b32 $2, 0xff800000; mov.b32 $3, 0xff800000; @$5 ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l,b"(ptr addrspace(1) %v22, i1 %v20)
  %v24 = extractvalue {float, float, float, float} %v23, 0
  %v25 = extractvalue {float, float, float, float} %v23, 1
  %v26 = extractvalue {float, float, float, float} %v23, 2
  %v27 = extractvalue {float, float, float, float} %v23, 3
  %v28 = add i32 %v15, 512
  %v29 = icmp ult i32 %v28, %cols
  %v30 = zext i32 %v28 to i64
  %v31 = getelementptr float, ptr addrspace(1) %v11, i64 %v30
  %v32 = call {float, float, float, float} asm sideeffect "mov.b32 $0, 0xff800000; mov.b32 $1, 0xff800000; mov.b32 $2, 0xff800000; mov.b32 $3, 0xff800000; @$5 ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l,b"(ptr addrspace(1) %v31, i1 %v29)
  %v33 = extractvalue {float, float, float, float} %v32, 0
  %v34 = extractvalue {float, float, float, float} %v32, 1
  %v35 = extractvalue {float, float, float, float} %v32, 2
  %v36 = extractvalue {float, float, float, float} %v32, 3
  %v37 = call float @llvm.maxnum.f32(float %v24, float %v25)
  %v38 = call float @llvm.maxnum.f32(float %v26, float %v27)
  %v39 = call float @llvm.maxnum.f32(float %v33, float %v34)
  %v40 = call float @llvm.maxnum.f32(float %v35, float %v36)
  %v41 = call float @llvm.maxnum.f32(float %v37, float %v38)
  %v42 = call float @llvm.maxnum.f32(float %v39, float %v40)
  %v43 = call float @llvm.maxnum.f32(float %v41, float %v42)
  %v44 = bitcast float %v43 to i32
  %v45 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v44, i32 16, i32 31)
  %v46 = bitcast i32 %v45 to float
  %v47 = call float @llvm.maxnum.f32(float %v43, float %v46)
  %v48 = bitcast float %v47 to i32
  %v49 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v48, i32 8, i32 31)
  %v50 = bitcast i32 %v49 to float
  %v51 = call float @llvm.maxnum.f32(float %v47, float %v50)
  %v52 = bitcast float %v51 to i32
  %v53 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v52, i32 4, i32 31)
  %v54 = bitcast i32 %v53 to float
  %v55 = call float @llvm.maxnum.f32(float %v51, float %v54)
  %v56 = bitcast float %v55 to i32
  %v57 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v56, i32 2, i32 31)
  %v58 = bitcast i32 %v57 to float
  %v59 = call float @llvm.maxnum.f32(float %v55, float %v58)
  %v60 = bitcast float %v59 to i32
  %v61 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v60, i32 1, i32 31)
  %v62 = bitcast i32 %v61 to float
  %v63 = call float @llvm.maxnum.f32(float %v59, float %v62)
  call void asm sideeffect "@$2 st.shared.b32 [$0], $1;", "r,f,b"(ptr addrspace(3) %v17, float %v63, i1 %v18)
  call void @llvm.nvvm.barrier0()
  %v64 = add i32 %v16, 0
  %v65 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v64
  %v66 = load volatile float, ptr addrspace(3) %v65, align 4
  %v67 = add i32 %v16, 1
  %v68 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v67
  %v69 = load volatile float, ptr addrspace(3) %v68, align 4
  %v70 = add i32 %v16, 2
  %v71 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v70
  %v72 = load volatile float, ptr addrspace(3) %v71, align 4
  %v73 = add i32 %v16, 3
  %v74 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v73
  %v75 = load volatile float, ptr addrspace(3) %v74, align 4
  %v76 = call float @llvm.maxnum.f32(float %v66, float %v69)
  %v77 = call float @llvm.maxnum.f32(float %v72, float %v75)
  %v78 = call float @llvm.maxnum.f32(float %v76, float %v77)
  call void @llvm.nvvm.barrier0()
  %v79 = fsub float %v24, %v78
  %v80 = fmul float %v79, 0x3FF7154760000000
  %v81 = call float @llvm.nvvm.ex2.approx.f32(float %v80)
  %v82 = fsub float %v25, %v78
  %v83 = fmul float %v82, 0x3FF7154760000000
  %v84 = call float @llvm.nvvm.ex2.approx.f32(float %v83)
  %v85 = fsub float %v26, %v78
  %v86 = fmul float %v85, 0x3FF7154760000000
  %v87 = call float @llvm.nvvm.ex2.approx.f32(float %v86)
  %v88 = fsub float %v27, %v78
  %v89 = fmul float %v88, 0x3FF7154760000000
  %v90 = call float @llvm.nvvm.ex2.approx.f32(float %v89)
  %v91 = fsub float %v33, %v78
  %v92 = fmul float %v91, 0x3FF7154760000000
  %v93 = call float @llvm.nvvm.ex2.approx.f32(float %v92)
  %v94 = fsub float %v34, %v78
  %v95 = fmul float %v94, 0x3FF7154760000000
  %v96 = call float @llvm.nvvm.ex2.approx.f32(float %v95)
  %v97 = fsub float %v35, %v78
  %v98 = fmul float %v97, 0x3FF7154760000000
  %v99 = call float @llvm.nvvm.ex2.approx.f32(float %v98)
  %v100 = fsub float %v36, %v78
  %v101 = fmul float %v100, 0x3FF7154760000000
  %v102 = call float @llvm.nvvm.ex2.approx.f32(float %v101)
  %v103 = fadd float %v81, %v84
  %v104 = fadd float %v87, %v90
  %v105 = fadd float %v93, %v96
  %v106 = fadd float %v99, %v102
  %v107 = fadd float %v103, %v104
  %v108 = fadd float %v105, %v106
  %v109 = fadd float %v107, %v108
  %v110 = bitcast float %v109 to i32
  %v111 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v110, i32 16, i32 31)
  %v112 = bitcast i32 %v111 to float
  %v113 = fadd float %v109, %v112
  %v114 = bitcast float %v113 to i32
  %v115 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v114, i32 8, i32 31)
  %v116 = bitcast i32 %v115 to float
  %v117 = fadd float %v113, %v116
  %v118 = bitcast float %v117 to i32
  %v119 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v118, i32 4, i32 31)
  %v120 = bitcast i32 %v119 to float
  %v121 = fadd float %v117, %v120
  %v122 = bitcast float %v121 to i32
  %v123 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v122, i32 2, i32 31)
  %v124 = bitcast i32 %v123 to float
  %v125 = fadd float %v121, %v124
  %v126 = bitcast float %v125 to i32
  %v127 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v126, i32 1, i32 31)
  %v128 = bitcast i32 %v127 to float
  %v129 = fadd float %v125, %v128
  call void asm sideeffect "@$2 st.shared.b32 [$0], $1;", "r,f,b"(ptr addrspace(3) %v17, float %v129, i1 %v18)
  call void @llvm.nvvm.barrier0()
  %v130 = add i32 %v16, 0
  %v131 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v130
  %v132 = load volatile float, ptr addrspace(3) %v131, align 4
  %v133 = add i32 %v16, 1
  %v134 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v133
  %v135 = load volatile float, ptr addrspace(3) %v134, align 4
  %v136 = add i32 %v16, 2
  %v137 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v136
  %v138 = load volatile float, ptr addrspace(3) %v137, align 4
  %v139 = add i32 %v16, 3
  %v140 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v139
  %v141 = load volatile float, ptr addrspace(3) %v140, align 4
  %v142 = fadd float %v132, %v135
  %v143 = fadd float %v138, %v141
  %v144 = fadd float %v142, %v143
  call void @llvm.nvvm.barrier0()
  %v145 = call float asm "rcp.approx.ftz.f32 $0, $1;", "=f,f"(float %v144)
  %v146 = getelementptr float, ptr addrspace(1) %v13, i64 %v21
  %v147 = fmul float %v81, %v145
  %v148 = fmul float %v84, %v145
  %v149 = fmul float %v87, %v145
  %v150 = fmul float %v90, %v145
  call void asm sideeffect "@$5 st.global.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,l,b"(float %v147, float %v148, float %v149, float %v150, ptr addrspace(1) %v146, i1 %v20)
  %v151 = getelementptr float, ptr addrspace(1) %v13, i64 %v30
  %v152 = fmul float %v93, %v145
  %v153 = fmul float %v96, %v145
  %v154 = fmul float %v99, %v145
  %v155 = fmul float %v102, %v145
  call void asm sideeffect "@$5 st.global.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,l,b"(float %v152, float %v153, float %v154, float %v155, ptr addrspace(1) %v151, i1 %v29)
