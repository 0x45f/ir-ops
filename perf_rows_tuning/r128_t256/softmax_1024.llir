  %v82 = call float @llvm.maxnum.f32(float %v77, float %v80)
  %v83 = call float @llvm.maxnum.f32(float %v81, float %v82)
  call void @llvm.nvvm.barrier0()
  %v84 = fsub float %v28, %v83
  %v85 = fmul float %v84, 0x3FF7154760000000
  %v86 = call float @llvm.nvvm.ex2.approx.f32(float %v85)
  %v87 = fsub float %v29, %v83
  %v88 = fmul float %v87, 0x3FF7154760000000
  %v89 = call float @llvm.nvvm.ex2.approx.f32(float %v88)
