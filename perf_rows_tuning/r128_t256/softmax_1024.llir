  %v21 = icmp eq i32 %v3, 0
  %v22 = add i32 %v18, 0
  %v23 = icmp ult i32 %v22, %cols
  %v24 = and i1 %v23, %v8
  %v25 = zext i32 %v22 to i64
  %v26 = getelementptr float, ptr addrspace(1) %v14, i64 %v25
  %v27 = call {float, float, float, float} asm sideeffect "mov.b32 $0, 0xff800000; mov.b32 $1, 0xff800000; mov.b32 $2, 0xff800000; mov.b32 $3, 0xff800000; @$5 ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l,b"(ptr addrspace(1) %v26, i1 %v24)
  %v28 = extractvalue {float, float, float, float} %v27, 0
  %v29 = extractvalue {float, float, float, float} %v27, 1
  %v30 = extractvalue {float, float, float, float} %v27, 2
  %v31 = extractvalue {float, float, float, float} %v27, 3
  %v32 = add i32 %v18, 512
  %v33 = icmp ult i32 %v32, %cols
  %v34 = and i1 %v33, %v8
  %v35 = zext i32 %v32 to i64
  %v36 = getelementptr float, ptr addrspace(1) %v14, i64 %v35
  %v37 = call {float, float, float, float} asm sideeffect "mov.b32 $0, 0xff800000; mov.b32 $1, 0xff800000; mov.b32 $2, 0xff800000; mov.b32 $3, 0xff800000; @$5 ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l,b"(ptr addrspace(1) %v36, i1 %v34)
