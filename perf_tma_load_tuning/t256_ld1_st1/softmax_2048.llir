  %v34 = call {float, float, float, float} asm sideeffect "mov.b32 $0, 0xff800000; mov.b32 $1, 0xff800000; mov.b32 $2, 0xff800000; mov.b32 $3, 0xff800000; @$5 ld.shared.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,r,b"(ptr addrspace(3) %v33, i1 %v31)
