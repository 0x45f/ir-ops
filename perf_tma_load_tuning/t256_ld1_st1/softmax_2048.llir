  %v95 = call float @llvm.maxnum.f32(float %v92, float %v93)
  %v96 = call float @llvm.maxnum.f32(float %v94, float %v95)
  call void @llvm.nvvm.barrier0()
  %v97 = fsub float %v26, %v96
  %v98 = fmul float %v97, 0x3FF7154760000000
  %v99 = call float @llvm.nvvm.ex2.approx.f32(float %v98)
  %v100 = fsub float %v27, %v96
  %v101 = fmul float %v100, 0x3FF7154760000000
  %v102 = call float @llvm.nvvm.ex2.approx.f32(float %v101)
  %v103 = fsub float %v28, %v96
