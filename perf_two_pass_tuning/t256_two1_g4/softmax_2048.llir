  %v31 = call float @llvm.maxnum.f32(float %v28, float %v29)
  %v32 = call float @llvm.maxnum.f32(float %v30, float %v31)
  %v33 = add i32 %v17, 1024
  %v34 = icmp ult i32 %v33, %cols
  %v35 = zext i32 %v33 to i64
  %v36 = getelementptr float, ptr addrspace(1) %v13, i64 %v35
  %v37 = call {float, float, float, float} asm sideeffect "mov.b32 $0, 0xff800000; mov.b32 $1, 0xff800000; mov.b32 $2, 0xff800000; mov.b32 $3, 0xff800000; @$5 ld.global.ca.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l,b"(ptr addrspace(1) %v36, i1 %v34)
  %v38 = extractvalue {float, float, float, float} %v37, 0
  %v39 = extractvalue {float, float, float, float} %v37, 1
  %v40 = extractvalue {float, float, float, float} %v37, 2
  %v41 = extractvalue {float, float, float, float} %v37, 3
