  %v159 = bitcast i32 %v158 to float
  %v160 = fadd float %v156, %v159
  %v161 = bitcast float %v160 to i32
  %v162 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v161, i32 1, i32 31)
