  %v58 = bitcast float %v57 to i32
  %v59 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v58, i32 2, i32 31)
  %v60 = bitcast i32 %v59 to float
  %v61 = call float @llvm.maxnum.f32(float %v57, float %v60)
  %v62 = bitcast float %v61 to i32
