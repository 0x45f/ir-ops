  %v92 = call float @llvm.maxnum.f32(float %v80, float %v83)
  %v93 = call float @llvm.maxnum.f32(float %v86, float %v89)
  %v94 = call float @llvm.maxnum.f32(float %v90, float %v91)
  %v95 = call float @llvm.maxnum.f32(float %v92, float %v93)
  %v96 = call float @llvm.maxnum.f32(float %v94, float %v95)
  call void @llvm.nvvm.barrier0()
  %v97 = add i32 %v17, 0
  %v98 = zext i32 %v97 to i64
  %v99 = getelementptr float, ptr addrspace(1) %v13, i64 %v98
  %v100 = call {float, float, float, float} asm sideeffect "ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l"(ptr addrspace(1) %v99)
  %v101 = extractvalue {float, float, float, float} %v100, 0
  %v102 = extractvalue {float, float, float, float} %v100, 1
  %v103 = extractvalue {float, float, float, float} %v100, 2
  %v104 = extractvalue {float, float, float, float} %v100, 3
