  %v171 = add i32 %v18, 2
  %v172 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v171
  %v173 = load volatile float, ptr addrspace(3) %v172, align 4
  %v174 = add i32 %v18, 3
  %v175 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v174
  %v176 = load volatile float, ptr addrspace(3) %v175, align 4
