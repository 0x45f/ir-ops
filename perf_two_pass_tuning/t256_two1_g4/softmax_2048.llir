  %v18 = mul i32 %v5, 8
  %v19 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v4
  %v20 = icmp eq i32 %v3, 0
  %v21 = add i32 %v17, 0
  %v22 = icmp ult i32 %v21, %cols
  %v23 = zext i32 %v21 to i64
  %v24 = getelementptr float, ptr addrspace(1) %v13, i64 %v23
  %v25 = call {float, float, float, float} asm sideeffect "mov.b32 $0, 0xff800000; mov.b32 $1, 0xff800000; mov.b32 $2, 0xff800000; mov.b32 $3, 0xff800000; @$5 ld.global.ca.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l,b"(ptr addrspace(1) %v24, i1 %v22)
  %v26 = extractvalue {float, float, float, float} %v25, 0
  %v27 = extractvalue {float, float, float, float} %v25, 1
  %v28 = extractvalue {float, float, float, float} %v25, 2
  %v29 = extractvalue {float, float, float, float} %v25, 3
