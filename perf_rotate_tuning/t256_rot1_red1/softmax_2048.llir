  %v143 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v142
  %v144 = load volatile float, ptr addrspace(3) %v143, align 4
  %v145 = add i32 %v16, 1
  %v146 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v145
  %v147 = load volatile float, ptr addrspace(3) %v146, align 4
  %v148 = add i32 %v16, 2
  %v149 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v148
  %v150 = load volatile float, ptr addrspace(3) %v149, align 4
  %v151 = add i32 %v16, 3
  %v152 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v151
