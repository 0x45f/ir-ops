  %v99 = call float @llvm.nvvm.ex2.approx.f32(float %v98)
  %v100 = fsub float %v31, %v90
  %v101 = fmul float %v100, 0x3FF7154760000000
  %v102 = call float @llvm.nvvm.ex2.approx.f32(float %v101)
  %v103 = fsub float %v40, %v90
  %v104 = fmul float %v103, 0x3FF7154760000000
  %v105 = call float @llvm.nvvm.ex2.approx.f32(float %v104)
  %v106 = fsub float %v41, %v90
  %v107 = fmul float %v106, 0x3FF7154760000000
  %v108 = call float @llvm.nvvm.ex2.approx.f32(float %v107)
  %v109 = fsub float %v42, %v90
  %v110 = fmul float %v109, 0x3FF7154760000000
  %v111 = call float @llvm.nvvm.ex2.approx.f32(float %v110)
  %v112 = fsub float %v43, %v90
  %v113 = fmul float %v112, 0x3FF7154760000000
  %v114 = call float @llvm.nvvm.ex2.approx.f32(float %v113)
  %v115 = fadd float %v93, %v96
  %v116 = fadd float %v99, %v102
  %v117 = fadd float %v105, %v108
  %v118 = fadd float %v111, %v114
  %v119 = fadd float %v115, %v116
  %v120 = fadd float %v117, %v118
  %v121 = fadd float %v119, %v120
  %v122 = bitcast float %v121 to i32
  %v123 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v122, i32 16, i32 31)
  %v124 = bitcast i32 %v123 to float
  %v125 = fadd float %v121, %v124
  %v126 = bitcast float %v125 to i32
  %v127 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v126, i32 8, i32 31)
  %v128 = bitcast i32 %v127 to float
  %v129 = fadd float %v125, %v128
  %v130 = bitcast float %v129 to i32
  %v131 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v130, i32 4, i32 31)
  %v132 = bitcast i32 %v131 to float
  %v133 = fadd float %v129, %v132
  %v134 = bitcast float %v133 to i32
  %v135 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v134, i32 2, i32 31)
  %v136 = bitcast i32 %v135 to float
  %v137 = fadd float %v133, %v136
  %v138 = bitcast float %v137 to i32
  %v139 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v138, i32 1, i32 31)
  %v140 = bitcast i32 %v139 to float
  %v141 = fadd float %v137, %v140
  call void asm sideeffect "@$2 st.shared.b32 [$0], $1;", "r,f,b"(ptr addrspace(3) %v17, float %v141, i1 %v18)
  call void @llvm.nvvm.barrier0()
