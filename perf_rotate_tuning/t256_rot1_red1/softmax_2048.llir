  %v47 = call float @llvm.maxnum.f32(float %v42, float %v43)
  %v48 = call float @llvm.maxnum.f32(float %v44, float %v45)
  %v49 = call float @llvm.maxnum.f32(float %v46, float %v47)
  %v50 = call float @llvm.maxnum.f32(float %v48, float %v49)
