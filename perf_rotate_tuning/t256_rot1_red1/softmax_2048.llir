  %v37 = zext i32 %v35 to i64
  %v38 = getelementptr float, ptr addrspace(1) %v11, i64 %v37
  %v39 = call {float, float, float, float} asm sideeffect "mov.b32 $0, 0xff800000; mov.b32 $1, 0xff800000; mov.b32 $2, 0xff800000; mov.b32 $3, 0xff800000; @$5 ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l,b"(ptr addrspace(1) %v38, i1 %v36)
  %v40 = extractvalue {float, float, float, float} %v39, 0
  %v41 = extractvalue {float, float, float, float} %v39, 1
  %v42 = extractvalue {float, float, float, float} %v39, 2
  %v43 = extractvalue {float, float, float, float} %v39, 3
  %v44 = call float @llvm.maxnum.f32(float %v28, float %v29)
  %v45 = call float @llvm.maxnum.f32(float %v30, float %v31)
