  %v92 = call float @llvm.nvvm.ex2.approx.f32(float %v91)
  %v93 = fsub float %v27, %v83
  %v94 = fmul float %v93, 0x3FF7154760000000
  %v95 = call float @llvm.nvvm.ex2.approx.f32(float %v94)
  %v96 = fsub float %v33, %v83
  %v97 = fmul float %v96, 0x3FF7154760000000
  %v98 = call float @llvm.nvvm.ex2.approx.f32(float %v97)
  %v99 = fsub float %v34, %v83
  %v100 = fmul float %v99, 0x3FF7154760000000
  %v101 = call float @llvm.nvvm.ex2.approx.f32(float %v100)
  %v102 = fsub float %v35, %v83
  %v103 = fmul float %v102, 0x3FF7154760000000
  %v104 = call float @llvm.nvvm.ex2.approx.f32(float %v103)
  %v105 = fsub float %v36, %v83
  %v106 = fmul float %v105, 0x3FF7154760000000
  %v107 = call float @llvm.nvvm.ex2.approx.f32(float %v106)
  %v108 = fadd float %v86, %v89
  %v109 = fadd float %v92, %v95
  %v110 = fadd float %v98, %v101
  %v111 = fadd float %v104, %v107
  %v112 = fadd float %v108, %v109
  %v113 = fadd float %v110, %v111
  %v114 = fadd float %v112, %v113
  %v115 = bitcast float %v114 to i32
  %v116 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v115, i32 16, i32 31)
  %v117 = bitcast i32 %v116 to float
  %v118 = fadd float %v114, %v117
  %v119 = bitcast float %v118 to i32
  %v120 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v119, i32 8, i32 31)
  %v121 = bitcast i32 %v120 to float
  %v122 = fadd float %v118, %v121
  %v123 = bitcast float %v122 to i32
  %v124 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v123, i32 4, i32 31)
  %v125 = bitcast i32 %v124 to float
  %v126 = fadd float %v122, %v125
  %v127 = bitcast float %v126 to i32
  %v128 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v127, i32 2, i32 31)
  %v129 = bitcast i32 %v128 to float
  %v130 = fadd float %v126, %v129
  %v131 = bitcast float %v130 to i32
  %v132 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v131, i32 1, i32 31)
  %v133 = bitcast i32 %v132 to float
  %v134 = fadd float %v130, %v133
  call void asm sideeffect "@$2 st.shared.b32 [$0], $1;", "r,f,b"(ptr addrspace(3) %v17, float %v134, i1 %v18)
  call void @llvm.nvvm.barrier0()
