  %v136 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v135
  %v137 = load volatile float, ptr addrspace(3) %v136, align 4
  %v138 = add i32 %v16, 1
  %v139 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v138
  %v140 = load volatile float, ptr addrspace(3) %v139, align 4
  %v141 = add i32 %v16, 2
  %v142 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v141
  %v143 = load volatile float, ptr addrspace(3) %v142, align 4
  %v144 = add i32 %v16, 3
  %v145 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v144
  %v146 = load volatile float, ptr addrspace(3) %v145, align 4
  %v147 = add i32 %v16, 4
  %v148 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v147
  %v149 = load volatile float, ptr addrspace(3) %v148, align 4
