  %v169 = fmul float %v89, %v166
  %v170 = fmul float %v92, %v166
  %v171 = fmul float %v95, %v166
  call void asm sideeffect "@$5 st.global.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,l,b"(float %v168, float %v169, float %v170, float %v171, ptr addrspace(1) %v167, i1 %v20)
