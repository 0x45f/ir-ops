; Direct LLVM IR rewrite: vector loads -> register reductions -> vector stores.
; block=256, num_warps=4, rows_per_cta=4, shared=0
target datalayout = "e-p3:32:32-p4:32:32-p5:32:32-p6:32:32-p7:32:32-i64:64-i128:128-v16:16-v32:32-n16:32:64"
@global_smem = external addrspace(3) global [0 x i8], align 16
define ptx_kernel void @softmax_kernel(ptr addrspace(1) %out, ptr addrspace(1) %in, i32 %istride, i32 %ostride, i32 %rows, i32 %cols, ptr addrspace(1) %scratch, ptr addrspace(1) %profile) #0 {
entry:
  %v1 = call i32 @llvm.nvvm.read.ptx.sreg.tid.x()
  %v2 = call i32 @llvm.nvvm.read.ptx.sreg.ctaid.x()
  %v3 = and i32 %v1, 31
  %v4 = lshr i32 %v1, 5
  %v5 = udiv i32 %v1, 32
  %v6 = mul i32 %v2, 4
  %v7 = add i32 %v6, %v5
  %v8 = icmp ult i32 %v7, %rows
  br i1 %v8, label %body, label %exit
body:
  %v9 = zext i32 %v7 to i64
  %v10 = zext i32 %istride to i64
  %v11 = zext i32 %ostride to i64
  %v12 = mul i64 %v9, %v10
  %v13 = getelementptr float, ptr addrspace(1) %in, i64 %v12
  %v14 = mul i64 %v9, %v11
  %v15 = getelementptr float, ptr addrspace(1) %out, i64 %v14
  %v16 = urem i32 %v1, 32
  %v17 = mul i32 %v16, 4
  %v18 = add i32 %v17, 0
  %v19 = icmp ult i32 %v18, %cols
  %v20 = zext i32 %v18 to i64
  %v21 = getelementptr float, ptr addrspace(1) %v13, i64 %v20
  %v22 = call {float, float, float, float} asm sideeffect "mov.b32 $0, 0xff800000; mov.b32 $1, 0xff800000; mov.b32 $2, 0xff800000; mov.b32 $3, 0xff800000; @$5 ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l,b"(ptr addrspace(1) %v21, i1 %v19)
  %v23 = extractvalue {float, float, float, float} %v22, 0
  %v24 = extractvalue {float, float, float, float} %v22, 1
  %v25 = extractvalue {float, float, float, float} %v22, 2
  %v26 = extractvalue {float, float, float, float} %v22, 3
  %v27 = add i32 %v17, 128
  %v28 = icmp ult i32 %v27, %cols
  %v29 = zext i32 %v27 to i64
  %v30 = getelementptr float, ptr addrspace(1) %v13, i64 %v29
  %v31 = call {float, float, float, float} asm sideeffect "mov.b32 $0, 0xff800000; mov.b32 $1, 0xff800000; mov.b32 $2, 0xff800000; mov.b32 $3, 0xff800000; @$5 ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l,b"(ptr addrspace(1) %v30, i1 %v28)
  %v32 = extractvalue {float, float, float, float} %v31, 0
  %v33 = extractvalue {float, float, float, float} %v31, 1
  %v34 = extractvalue {float, float, float, float} %v31, 2
  %v35 = extractvalue {float, float, float, float} %v31, 3
  %v36 = call float @llvm.maxnum.f32(float %v23, float %v24)
  %v37 = call float @llvm.maxnum.f32(float %v25, float %v26)
  %v38 = call float @llvm.maxnum.f32(float %v32, float %v33)
  %v39 = call float @llvm.maxnum.f32(float %v34, float %v35)
  %v40 = call float @llvm.maxnum.f32(float %v36, float %v37)
  %v41 = call float @llvm.maxnum.f32(float %v38, float %v39)
  %v42 = call float @llvm.maxnum.f32(float %v40, float %v41)
  %v43 = bitcast float %v42 to i32
  %v44 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v43, i32 16, i32 31)
  %v45 = bitcast i32 %v44 to float
  %v46 = call float @llvm.maxnum.f32(float %v42, float %v45)
  %v47 = bitcast float %v46 to i32
  %v48 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v47, i32 8, i32 31)
  %v49 = bitcast i32 %v48 to float
  %v50 = call float @llvm.maxnum.f32(float %v46, float %v49)
  %v51 = bitcast float %v50 to i32
  %v52 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v51, i32 4, i32 31)
  %v53 = bitcast i32 %v52 to float
  %v54 = call float @llvm.maxnum.f32(float %v50, float %v53)
  %v55 = bitcast float %v54 to i32
  %v56 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v55, i32 2, i32 31)
  %v57 = bitcast i32 %v56 to float
  %v58 = call float @llvm.maxnum.f32(float %v54, float %v57)
  %v59 = bitcast float %v58 to i32
  %v60 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v59, i32 1, i32 31)
  %v61 = bitcast i32 %v60 to float
  %v62 = call float @llvm.maxnum.f32(float %v58, float %v61)
  %v63 = fsub float %v23, %v62
  %v64 = fmul float %v63, 0x3FF7154760000000
  %v65 = call float @llvm.nvvm.ex2.approx.f32(float %v64)
  %v66 = fsub float %v24, %v62
  %v67 = fmul float %v66, 0x3FF7154760000000
  %v68 = call float @llvm.nvvm.ex2.approx.f32(float %v67)
  %v69 = fsub float %v25, %v62
  %v70 = fmul float %v69, 0x3FF7154760000000
  %v71 = call float @llvm.nvvm.ex2.approx.f32(float %v70)
  %v72 = fsub float %v26, %v62
  %v73 = fmul float %v72, 0x3FF7154760000000
  %v74 = call float @llvm.nvvm.ex2.approx.f32(float %v73)
  %v75 = fsub float %v32, %v62
  %v76 = fmul float %v75, 0x3FF7154760000000
  %v77 = call float @llvm.nvvm.ex2.approx.f32(float %v76)
  %v78 = fsub float %v33, %v62
  %v79 = fmul float %v78, 0x3FF7154760000000
  %v80 = call float @llvm.nvvm.ex2.approx.f32(float %v79)
  %v81 = fsub float %v34, %v62
  %v82 = fmul float %v81, 0x3FF7154760000000
  %v83 = call float @llvm.nvvm.ex2.approx.f32(float %v82)
  %v84 = fsub float %v35, %v62
  %v85 = fmul float %v84, 0x3FF7154760000000
  %v86 = call float @llvm.nvvm.ex2.approx.f32(float %v85)
  %v87 = fadd float %v65, %v68
  %v88 = fadd float %v71, %v74
  %v89 = fadd float %v77, %v80
  %v90 = fadd float %v83, %v86
  %v91 = fadd float %v87, %v88
  %v92 = fadd float %v89, %v90
  %v93 = fadd float %v91, %v92
  %v94 = bitcast float %v93 to i32
  %v95 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v94, i32 16, i32 31)
  %v96 = bitcast i32 %v95 to float
  %v97 = fadd float %v93, %v96
  %v98 = bitcast float %v97 to i32
  %v99 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v98, i32 8, i32 31)
  %v100 = bitcast i32 %v99 to float
  %v101 = fadd float %v97, %v100
  %v102 = bitcast float %v101 to i32
  %v103 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v102, i32 4, i32 31)
  %v104 = bitcast i32 %v103 to float
  %v105 = fadd float %v101, %v104
  %v106 = bitcast float %v105 to i32
  %v107 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v106, i32 2, i32 31)
  %v108 = bitcast i32 %v107 to float
  %v109 = fadd float %v105, %v108
  %v110 = bitcast float %v109 to i32
  %v111 = call i32 @llvm.nvvm.shfl.sync.bfly.i32(i32 -1, i32 %v110, i32 1, i32 31)
  %v112 = bitcast i32 %v111 to float
  %v113 = fadd float %v109, %v112
  %v114 = call float asm "rcp.approx.ftz.f32 $0, $1;", "=f,f"(float %v113)
  %v115 = getelementptr float, ptr addrspace(1) %v15, i64 %v20
  %v116 = fmul float %v65, %v114
  %v117 = fmul float %v68, %v114
  %v118 = fmul float %v71, %v114
  %v119 = fmul float %v74, %v114
  call void asm sideeffect "@$5 st.global.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,l,b"(float %v116, float %v117, float %v118, float %v119, ptr addrspace(1) %v115, i1 %v19)
  %v120 = getelementptr float, ptr addrspace(1) %v15, i64 %v29
  %v121 = fmul float %v77, %v114
  %v122 = fmul float %v80, %v114
  %v123 = fmul float %v83, %v114
  %v124 = fmul float %v86, %v114
  call void asm sideeffect "@$5 st.global.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,l,b"(float %v121, float %v122, float %v123, float %v124, ptr addrspace(1) %v120, i1 %v28)
  br label %exit
exit:
  ret void
}
declare i32 @llvm.nvvm.read.ptx.sreg.tid.x()
declare i32 @llvm.nvvm.read.ptx.sreg.ctaid.x()
declare float @llvm.maxnum.f32(float, float)
declare i32 @llvm.nvvm.shfl.sync.bfly.i32(i32, i32, i32, i32)
declare float @llvm.nvvm.ex2.approx.f32(float)
declare void @llvm.nvvm.barrier0()
attributes #0 = { nounwind "nvvm.reqntid"="128" }
