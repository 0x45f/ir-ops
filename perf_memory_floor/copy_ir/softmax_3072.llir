  call void asm sideeffect "st.global.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,l"(float %v84, float %v85, float %v86, float %v87, ptr addrspace(1) %v83)
  %v88 = getelementptr float, ptr addrspace(1) %v13, i64 %v52
  %v89 = fmul float %v55, 1.000000e+00
  %v90 = fmul float %v56, 1.000000e+00
  %v91 = fmul float %v57, 1.000000e+00
  %v92 = fmul float %v58, 1.000000e+00
  call void asm sideeffect "st.global.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,l"(float %v89, float %v90, float %v91, float %v92, ptr addrspace(1) %v88)
  %v93 = getelementptr float, ptr addrspace(1) %v13, i64 %v61
  %v94 = fmul float %v64, 1.000000e+00
  %v95 = fmul float %v65, 1.000000e+00
  %v96 = fmul float %v66, 1.000000e+00
  %v97 = fmul float %v67, 1.000000e+00
  call void asm sideeffect "@$5 st.global.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,l,b"(float %v94, float %v95, float %v96, float %v97, ptr addrspace(1) %v93, i1 %v60)
  br label %exit
exit:
