body:
  %v7 = zext i32 %v2 to i64
  %v8 = zext i32 %istride to i64
  %v9 = zext i32 %ostride to i64
  %v10 = mul i64 %v7, %v8
  %v11 = getelementptr float, ptr addrspace(1) %in, i64 %v10
  %v12 = mul i64 %v7, %v9
  %v13 = getelementptr float, ptr addrspace(1) %out, i64 %v12
  %v14 = urem i32 %v1, 128
  %v15 = mul i32 %v14, 4
  %v16 = mul i32 %v5, 4
  %v17 = getelementptr float, ptr addrspace(3) @global_smem, i32 %v4
  %v18 = icmp eq i32 %v3, 0
  %v19 = add i32 %v15, 0
  %v20 = zext i32 %v19 to i64
  %v21 = getelementptr float, ptr addrspace(1) %v11, i64 %v20
  %v22 = call {float, float, float, float} asm sideeffect "ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l"(ptr addrspace(1) %v21)
  %v23 = extractvalue {float, float, float, float} %v22, 0
  %v24 = extractvalue {float, float, float, float} %v22, 1
  %v25 = extractvalue {float, float, float, float} %v22, 2
  %v26 = extractvalue {float, float, float, float} %v22, 3
