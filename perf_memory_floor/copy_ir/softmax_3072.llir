  %v77 = fmul float %v34, 1.000000e+00
  call void asm sideeffect "st.global.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,l"(float %v74, float %v75, float %v76, float %v77, ptr addrspace(1) %v73)
  %v78 = getelementptr float, ptr addrspace(1) %v13, i64 %v36
