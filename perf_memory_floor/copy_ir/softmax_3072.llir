  %v39 = extractvalue {float, float, float, float} %v38, 0
  %v40 = extractvalue {float, float, float, float} %v38, 1
  %v41 = extractvalue {float, float, float, float} %v38, 2
  %v42 = extractvalue {float, float, float, float} %v38, 3
  %v43 = add i32 %v15, 1536
  %v44 = zext i32 %v43 to i64
  %v45 = getelementptr float, ptr addrspace(1) %v11, i64 %v44
  %v46 = call {float, float, float, float} asm sideeffect "ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l"(ptr addrspace(1) %v45)
  %v47 = extractvalue {float, float, float, float} %v46, 0
  %v48 = extractvalue {float, float, float, float} %v46, 1
  %v49 = extractvalue {float, float, float, float} %v46, 2
  %v50 = extractvalue {float, float, float, float} %v46, 3
  %v51 = add i32 %v15, 2048
  %v52 = zext i32 %v51 to i64
  %v53 = getelementptr float, ptr addrspace(1) %v11, i64 %v52
  %v54 = call {float, float, float, float} asm sideeffect "ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l"(ptr addrspace(1) %v53)
  %v55 = extractvalue {float, float, float, float} %v54, 0
  %v56 = extractvalue {float, float, float, float} %v54, 1
  %v57 = extractvalue {float, float, float, float} %v54, 2
  %v58 = extractvalue {float, float, float, float} %v54, 3
  %v59 = add i32 %v15, 2560
  %v60 = icmp ult i32 %v59, %cols
  %v61 = zext i32 %v59 to i64
  %v62 = getelementptr float, ptr addrspace(1) %v11, i64 %v61
  %v63 = call {float, float, float, float} asm sideeffect "mov.b32 $0, 0xff800000; mov.b32 $1, 0xff800000; mov.b32 $2, 0xff800000; mov.b32 $3, 0xff800000; @$5 ld.global.v4.b32 {$0,$1,$2,$3}, [$4];", "=f,=f,=f,=f,l,b"(ptr addrspace(1) %v62, i1 %v60)
  %v64 = extractvalue {float, float, float, float} %v63, 0
  %v65 = extractvalue {float, float, float, float} %v63, 1
  %v66 = extractvalue {float, float, float, float} %v63, 2
  %v67 = extractvalue {float, float, float, float} %v63, 3
  %v68 = getelementptr float, ptr addrspace(1) %v13, i64 %v20
  %v69 = fmul float %v23, 1.000000e+00
  %v70 = fmul float %v24, 1.000000e+00
  %v71 = fmul float %v25, 1.000000e+00
  %v72 = fmul float %v26, 1.000000e+00
  call void asm sideeffect "st.global.v4.b32 [$4], {$0,$1,$2,$3};", "f,f,f,f,l"(float %v69, float %v70, float %v71, float %v72, ptr addrspace(1) %v68)
  %v73 = getelementptr float, ptr addrspace(1) %v13, i64 %v28
