; Direct LLVM IR rewrite: vector loads -> register reductions -> vector stores.
; block=2048, num_warps=4, rows_per_cta=1, shared=16
target datalayout = "e-p3:32:32-p4:32:32-p5:32:32-p6:32:32-p7:32:32-i64:64-i128:128-v16:16-v32:32-n16:32:64"
@global_smem = external addrspace(3) global [0 x i8], align 16
define ptx_kernel void @softmax_kernel(ptr addrspace(1) %out, ptr addrspace(1) %in, i32 %istride, i32 %ostride, i32 %rows, i32 %cols, ptr addrspace(1) %scratch, ptr addrspace(1) %profile) #0 {
entry:
  %v1 = call i32 @llvm.nvvm.read.ptx.sreg.tid.x()
  %v2 = call i32 @llvm.nvvm.read.ptx.sreg.ctaid.x()
  %v3 = and i32 %v1, 31
  %v4 = lshr i32 %v1, 5
  %v5 = call i32 @llvm.nvvm.read.ptx.sreg.nctaid.x()
  %v6 = mul i32 %v5, 1
  br label %row_loop
row_loop:
  %row = phi i32 [%v2, %entry], [%nextrow, %advance]
  %v7 = icmp ult i32 %row, %rows
  br i1 %v7, label %body, label %exit
body:
  %v8 = zext i32 %row to i64
  %v9 = zext i32 %istride to i64
